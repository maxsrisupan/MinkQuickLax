<UserControl x:Class="MinkQuickLax.Settings.Pages.VisibilityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:MinkQuickLax.Services"
             xmlns:settings="clr-namespace:MinkQuickLax.Settings"
             xmlns:model="clr-namespace:MinkQuickLax.Core.Model;assembly=MinkQuickLax.Core">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="28,0,28,28" MaxWidth="760">
      <TextBlock Style="{StaticResource Settings.PageTitle}" Text="{s:Text Page_Visibility}" />
      <StackPanel Style="{StaticResource Settings.Group}">
        <settings:SettingRow settings:SearchAnchor.Id="TrayClick" HeaderText="{s:Text Settings_TrayClick}" Hint="{s:Text Settings_TrayClickHint}">
          <CheckBox Style="{StaticResource Skin.Switch}" IsChecked="{Binding TrayClickToggles}" AutomationProperties.Name="{s:Text Settings_TrayClick}" />
        </settings:SettingRow>
      </StackPanel>
      <Button Style="{StaticResource Skin.OutlineButton}" HorizontalAlignment="Left" Content="{s:Text Settings_Reset}"
              Command="{Binding ResetCommand}" CommandParameter="{x:Static model:SettingsSection.Visibility}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
