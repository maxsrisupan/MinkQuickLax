<UserControl x:Class="MinkQuickLax.Settings.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="clr-namespace:MinkQuickLax.Styles"
             xmlns:s="clr-namespace:MinkQuickLax.Services"
             xmlns:settings="clr-namespace:MinkQuickLax.Settings"
             xmlns:model="clr-namespace:MinkQuickLax.Core.Model;assembly=MinkQuickLax.Core">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="28,0,28,28" MaxWidth="760">
      <TextBlock Style="{StaticResource Settings.PageTitle}" Text="{s:Text Page_Appearance}" />

      <!-- SPEC 5.10: three style choices with pictures, like the mockup's inspector. -->
      <StackPanel Style="{StaticResource Settings.Group}" settings:SearchAnchor.Id="Style">
        <settings:SettingsGroupHeader Text="{s:Text Settings_Style}" />
        <styles:RoundedBorder Style="{StaticResource Skin.SegmentTrack}">
          <UniformGrid Rows="1" KeyboardNavigation.DirectionalNavigation="Cycle">
            <RadioButton Style="{StaticResource Skin.PictureSegment}" GroupName="style" Content="{s:Text Style_Hud}"
                         IsChecked="{Binding Style, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:StyleSetting.Hud}}">
              <RadioButton.Tag>
                <settings:StylePreview StyleKind="Hud" />
              </RadioButton.Tag>
            </RadioButton>
            <RadioButton Style="{StaticResource Skin.PictureSegment}" GroupName="style" Content="{s:Text Style_Dot}"
                         IsChecked="{Binding Style, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:StyleSetting.Dot}}">
              <RadioButton.Tag>
                <settings:StylePreview StyleKind="Dot" />
              </RadioButton.Tag>
            </RadioButton>
            <RadioButton Style="{StaticResource Skin.PictureSegment}" GroupName="style" Content="{s:Text Style_Glass}"
                         IsChecked="{Binding Style, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:StyleSetting.Glass}}">
              <RadioButton.Tag>
                <settings:StylePreview StyleKind="Glass" />
              </RadioButton.Tag>
            </RadioButton>
          </UniformGrid>
        </styles:RoundedBorder>
        <TextBlock Style="{StaticResource Settings.Hint}" Margin="2,8,0,0" Text="{Binding StyleNote}" />
      </StackPanel>

      <StackPanel Style="{StaticResource Settings.Group}" settings:SearchAnchor.Id="Theme">
        <settings:SettingsGroupHeader Text="{s:Text Settings_Theme}" />
        <styles:RoundedBorder Style="{StaticResource Skin.SegmentTrack}">
          <UniformGrid Rows="1">
            <RadioButton Style="{StaticResource Skin.Segment}" GroupName="theme" Content="{s:Text Common_SameAsWindows}"
                         IsChecked="{Binding Theme, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:ThemeSetting.System}}" />
            <RadioButton Style="{StaticResource Skin.Segment}" GroupName="theme" Content="{s:Text Theme_Light}"
                         IsChecked="{Binding Theme, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:ThemeSetting.Light}}" />
            <RadioButton Style="{StaticResource Skin.Segment}" GroupName="theme" Content="{s:Text Theme_Dark}"
                         IsChecked="{Binding Theme, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:ThemeSetting.Dark}}" />
          </UniformGrid>
        </styles:RoundedBorder>
        <TextBlock Style="{StaticResource Settings.Hint}" Margin="2,8,0,0" Text="{s:Text Settings_HudAlwaysDark}"
                   Visibility="{Binding Style, Converter={x:Static settings:VisibleWhenConverter.Instance}, ConverterParameter={x:Static model:StyleSetting.Hud}}" />
      </StackPanel>

      <StackPanel Style="{StaticResource Settings.Group}">
        <settings:SettingsGroupHeader Text="{s:Text Settings_GroupIcons}" />
        <settings:SettingRow Layout="Stacked" settings:SearchAnchor.Id="IconSize" HeaderText="{s:Text Settings_IconSize}" ValueText="{Binding IconSizeText}">
          <Slider Style="{StaticResource Skin.Slider}" TickFrequency="4" IsSnapToTickEnabled="True" SmallChange="4" LargeChange="8"
                  Minimum="{x:Static settings:SliderLimits.IconSizeMin}" Maximum="{x:Static settings:SliderLimits.IconSizeMax}"
                  Value="{Binding IconSize}" AutomationProperties.Name="{s:Text Settings_IconSize}" />
        </settings:SettingRow>
        <settings:SettingRow Layout="Stacked" settings:SearchAnchor.Id="IdleOpacity" HeaderText="{s:Text Settings_IdleOpacity}" ValueText="{Binding IdleOpacityText}">
          <Slider Style="{StaticResource Skin.Slider}" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" Minimum="30" Maximum="100"
                  Value="{Binding IdleOpacityPercent}" AutomationProperties.Name="{s:Text Settings_IdleOpacity}" />
        </settings:SettingRow>
        <settings:SettingRow Layout="Stacked" settings:SearchAnchor.Id="ProximityRadius" HeaderText="{s:Text Settings_ProximityRadius}"
                             Hint="{s:Text Settings_ProximityRadiusHint}" ValueText="{Binding ProximityRadiusText}">
          <Slider Style="{StaticResource Skin.Slider}" TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="50"
                  Minimum="{x:Static settings:SliderLimits.ProximityRadiusMin}" Maximum="{x:Static settings:SliderLimits.ProximityRadiusMax}"
                  Value="{Binding ProximityRadius}" AutomationProperties.Name="{s:Text Settings_ProximityRadius}" />
        </settings:SettingRow>
        <settings:SettingRow settings:SearchAnchor.Id="Magnify" HeaderText="{s:Text Settings_Magnify}">
          <CheckBox Style="{StaticResource Skin.Switch}" IsChecked="{Binding Magnify}" AutomationProperties.Name="{s:Text Settings_Magnify}" />
        </settings:SettingRow>
        <settings:SettingRow settings:SearchAnchor.Id="ShowLabels" HeaderText="{s:Text Settings_ShowLabels}">
          <CheckBox Style="{StaticResource Skin.Switch}" IsChecked="{Binding ShowLabels}" AutomationProperties.Name="{s:Text Settings_ShowLabels}" />
        </settings:SettingRow>
      </StackPanel>

      <StackPanel Style="{StaticResource Settings.Group}" settings:SearchAnchor.Id="ReduceMotion">
        <settings:SettingsGroupHeader Text="{s:Text Settings_ReduceMotion}" />
        <styles:RoundedBorder Style="{StaticResource Skin.SegmentTrack}">
          <UniformGrid Rows="1">
            <RadioButton Style="{StaticResource Skin.Segment}" GroupName="motion" Content="{s:Text Common_SameAsWindows}"
                         IsChecked="{Binding ReduceMotion, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:ReduceMotionSetting.System}}" />
            <RadioButton Style="{StaticResource Skin.Segment}" GroupName="motion" Content="{s:Text Common_On}"
                         IsChecked="{Binding ReduceMotion, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:ReduceMotionSetting.On}}" />
            <RadioButton Style="{StaticResource Skin.Segment}" GroupName="motion" Content="{s:Text Common_Off}"
                         IsChecked="{Binding ReduceMotion, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:ReduceMotionSetting.Off}}" />
          </UniformGrid>
        </styles:RoundedBorder>
      </StackPanel>

      <!-- SPEC 5.6: only for Glass. -->
      <StackPanel Style="{StaticResource Settings.Group}"
                  Visibility="{Binding Style, Converter={x:Static settings:VisibleWhenConverter.Instance}, ConverterParameter={x:Static model:StyleSetting.Glass}}">
        <settings:SettingsGroupHeader Text="{s:Text Settings_Glass}" />
        <UniformGrid Rows="1" Margin="0,0,0,12" HorizontalAlignment="Left" settings:SearchAnchor.Id="GlassTint">
          <RadioButton Style="{StaticResource Skin.Swatch}" GroupName="tint" Content="{s:Text Tint_Auto}" Tag="{DynamicResource Skin.Fill.Popup}" Margin="0,0,14,0"
                       IsChecked="{Binding GlassTint, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:GlassTint.Auto}}" />
          <RadioButton Style="{StaticResource Skin.Swatch}" GroupName="tint" Content="{s:Text Tint_Lagoon}" Tag="{StaticResource Settings.Swatch.Lagoon}" Margin="0,0,14,0"
                       IsChecked="{Binding GlassTint, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:GlassTint.Lagoon}}" />
          <RadioButton Style="{StaticResource Skin.Swatch}" GroupName="tint" Content="{s:Text Tint_Ember}" Tag="{StaticResource Settings.Swatch.Ember}" Margin="0,0,14,0"
                       IsChecked="{Binding GlassTint, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:GlassTint.Ember}}" />
          <RadioButton Style="{StaticResource Skin.Swatch}" GroupName="tint" Content="{s:Text Tint_Ink}" Tag="{StaticResource Settings.Swatch.Ink}"
                       IsChecked="{Binding GlassTint, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:GlassTint.Ink}}" />
        </UniformGrid>
        <settings:SettingRow Layout="Stacked" settings:SearchAnchor.Id="GlassStrength" HeaderText="{s:Text Settings_GlassStrength}" ValueText="{Binding GlassStrengthText}">
          <Slider Style="{StaticResource Skin.Slider}" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" Minimum="0" Maximum="70"
                  Value="{Binding GlassStrengthPercent}" AutomationProperties.Name="{s:Text Settings_GlassStrength}" />
        </settings:SettingRow>
        <settings:SettingRow settings:SearchAnchor.Id="GlassBlur" HeaderText="{s:Text Settings_GlassBlur}" Hint="{s:Text Settings_GlassBlurHint}">
          <CheckBox Style="{StaticResource Skin.Switch}" IsChecked="{Binding GlassBlur}" AutomationProperties.Name="{s:Text Settings_GlassBlur}" />
        </settings:SettingRow>
      </StackPanel>

      <Button Style="{StaticResource Skin.OutlineButton}" HorizontalAlignment="Left" Content="{s:Text Settings_Reset}"
              Command="{Binding ResetCommand}" CommandParameter="{x:Static model:SettingsSection.Appearance}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
