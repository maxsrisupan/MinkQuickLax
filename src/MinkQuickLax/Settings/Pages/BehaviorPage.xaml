<UserControl x:Class="MinkQuickLax.Settings.Pages.BehaviorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:MinkQuickLax.Services"
             xmlns:settings="clr-namespace:MinkQuickLax.Settings"
             xmlns:model="clr-namespace:MinkQuickLax.Core.Model;assembly=MinkQuickLax.Core">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="28,0,28,28" MaxWidth="760">
      <TextBlock Style="{StaticResource Settings.PageTitle}" Text="{s:Text Page_Behavior}" />

      <StackPanel Style="{StaticResource Settings.Group}" settings:SearchAnchor.Id="LaunchOn">
        <settings:SettingsGroupHeader Text="{s:Text Settings_LaunchOn}" />
        <Border Style="{StaticResource Skin.SegmentTrack}">
          <UniformGrid Rows="1">
            <RadioButton Style="{StaticResource Skin.Segment}" GroupName="launch" Content="{s:Text Launch_Single}"
                         IsChecked="{Binding LaunchOn, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:LaunchTrigger.SingleClick}}" />
            <RadioButton Style="{StaticResource Skin.Segment}" GroupName="launch" Content="{s:Text Launch_Double}"
                         IsChecked="{Binding LaunchOn, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:LaunchTrigger.DoubleClick}}" />
          </UniformGrid>
        </Border>
      </StackPanel>

      <StackPanel Style="{StaticResource Settings.Group}">
        <settings:SettingRow Layout="Stacked" settings:SearchAnchor.Id="TooltipDelay" HeaderText="{s:Text Settings_TooltipDelay}" ValueText="{Binding TooltipDelayText}">
          <Slider Style="{StaticResource Skin.Slider}" TickFrequency="50" IsSnapToTickEnabled="True" SmallChange="50" LargeChange="250"
                  Minimum="{x:Static settings:SliderLimits.TooltipDelayMin}" Maximum="{x:Static settings:SliderLimits.TooltipDelayMax}"
                  Value="{Binding TooltipDelay}" AutomationProperties.Name="{s:Text Settings_TooltipDelay}" />
        </settings:SettingRow>
      </StackPanel>

      <Button Style="{StaticResource Skin.OutlineButton}" HorizontalAlignment="Left" Content="{s:Text Settings_Reset}"
              Command="{Binding ResetCommand}" CommandParameter="{x:Static model:SettingsSection.Behavior}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
