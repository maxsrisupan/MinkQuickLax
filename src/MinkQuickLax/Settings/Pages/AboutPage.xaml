<UserControl x:Class="MinkQuickLax.Settings.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:MinkQuickLax.Services"
             xmlns:settings="clr-namespace:MinkQuickLax.Settings">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="28,0,28,28" MaxWidth="760">
      <TextBlock Style="{StaticResource Settings.PageTitle}" Text="{s:Text Page_About}" />

      <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
        <Image Width="56" Height="56" Source="pack://application:,,,/Assets/AppIcon.ico" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Skin.Text}" FontFamily="{DynamicResource Font.Heading}" FontSize="20" FontWeight="SemiBold" Text="{s:Text Tray_ToolTip}" />
          <TextBlock Style="{StaticResource Settings.Hint}" FontFamily="{DynamicResource Font.Mono}" Text="{Binding VersionText}" />
          <TextBlock Style="{StaticResource Settings.Hint}" Text="{s:Text About_Tagline}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Style="{StaticResource Settings.Group}">
        <settings:SettingRow HeaderText="{s:Text About_Manual}">
          <!-- The user guide arrives in M10. -->
          <Button Style="{StaticResource Skin.OutlineButton}" Content="{s:Text About_Manual}" IsEnabled="False" />
        </settings:SettingRow>
        <settings:SettingRow settings:SearchAnchor.Id="GitHub" HeaderText="{s:Text About_GitHub}">
          <Button Style="{StaticResource Skin.OutlineButton}" Content="{s:Text About_GitHub}" Command="{Binding OpenGitHubCommand}" />
        </settings:SettingRow>
        <settings:SettingRow settings:SearchAnchor.Id="CopyInfo" HeaderText="{s:Text About_CopyInfo}" Hint="{s:Text About_CopyInfoHint}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Settings.Hint}" VerticalAlignment="Center" Margin="0,0,10,0" Text="{s:Text About_Copied}"
                       Visibility="{Binding Copied, Converter={x:Static settings:VisibleWhenConverter.Instance}}" />
            <Button Style="{StaticResource Skin.OutlineButton}" Content="{s:Text About_CopyInfo}" Command="{Binding CopyInfoCommand}" />
          </StackPanel>
        </settings:SettingRow>
      </StackPanel>

      <StackPanel Style="{StaticResource Settings.Group}" settings:SearchAnchor.Id="Licenses">
        <settings:SettingsGroupHeader Text="{s:Text About_Licenses}" />
        <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,0,0,10" Text="{s:Text About_LicensesHint}" />
        <ItemsControl ItemsSource="{Binding Components}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="settings:Component">
              <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Skin.Text}" FontSize="13" Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Settings.Hint}" FontFamily="{DynamicResource Font.Mono}" Text="{Binding License}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Style="{StaticResource Skin.OutlineButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="{s:Text About_OpenLicenses}"
                Command="{Binding OpenLicensesCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
