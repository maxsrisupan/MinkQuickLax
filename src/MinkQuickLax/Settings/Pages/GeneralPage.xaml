<UserControl x:Class="MinkQuickLax.Settings.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:MinkQuickLax.Services"
             xmlns:settings="clr-namespace:MinkQuickLax.Settings"
             xmlns:model="clr-namespace:MinkQuickLax.Core.Model;assembly=MinkQuickLax.Core">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="28,0,28,28" MaxWidth="760">
      <TextBlock Style="{StaticResource Settings.PageTitle}" Text="{s:Text Page_General}" />

      <StackPanel Style="{StaticResource Settings.Group}">
        <settings:SettingRow settings:SearchAnchor.Id="StartWithWindows" HeaderText="{s:Text Settings_StartWithWindows}" Hint="{s:Text Settings_StartWithWindowsHint}">
          <CheckBox Style="{StaticResource Skin.Switch}" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="{s:Text Settings_StartWithWindows}" />
        </settings:SettingRow>
        <!-- SPEC 4.10: Task Manager's choice is shown, never undone on its own. -->
        <TextBlock Style="{StaticResource Settings.Hint}" Foreground="{DynamicResource Skin.Amber}" Margin="0,-6,0,8" Text="{s:Text Settings_StartupDisabled}"
                   Visibility="{Binding StartupDisabledInTaskManager, Converter={x:Static settings:VisibleWhenConverter.Instance}}" />
      </StackPanel>

      <StackPanel Style="{StaticResource Settings.Group}" settings:SearchAnchor.Id="Language">
        <settings:SettingsGroupHeader Text="{s:Text Settings_Language}" />
        <Border Style="{StaticResource Skin.SegmentTrack}">
          <UniformGrid Rows="1">
            <RadioButton Style="{StaticResource Skin.Segment}" GroupName="language" Content="{s:Text Common_SameAsWindows}"
                         IsChecked="{Binding Language, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:LanguageSetting.System}}" />
            <RadioButton Style="{StaticResource Skin.Segment}" GroupName="language" Content="{s:Text Language_Th}"
                         IsChecked="{Binding Language, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:LanguageSetting.Th}}" />
            <RadioButton Style="{StaticResource Skin.Segment}" GroupName="language" Content="{s:Text Language_En}"
                         IsChecked="{Binding Language, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:LanguageSetting.En}}" />
          </UniformGrid>
        </Border>
      </StackPanel>

      <StackPanel Style="{StaticResource Settings.Group}">
        <settings:SettingsGroupHeader Text="{s:Text Settings_GroupUpdates}" />
        <settings:SettingRow settings:SearchAnchor.Id="CheckUpdates" HeaderText="{s:Text Settings_CheckUpdates}">
          <CheckBox Style="{StaticResource Skin.Switch}" IsChecked="{Binding CheckForUpdates}" AutomationProperties.Name="{s:Text Settings_CheckUpdates}" />
        </settings:SettingRow>
        <settings:SettingRow settings:SearchAnchor.Id="UpdateChannel" HeaderText="{s:Text Settings_UpdateChannel}">
          <Border Style="{StaticResource Skin.SegmentTrack}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource Skin.Segment}" GroupName="channel" Content="{s:Text Channel_Stable}" MinWidth="80"
                           IsChecked="{Binding UpdateChannel, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:UpdateChannel.Stable}}" />
              <RadioButton Style="{StaticResource Skin.Segment}" GroupName="channel" Content="{s:Text Channel_Beta}" MinWidth="80"
                           IsChecked="{Binding UpdateChannel, Converter={x:Static settings:EnumIsConverter.Instance}, ConverterParameter={x:Static model:UpdateChannel.Beta}}" />
            </StackPanel>
          </Border>
        </settings:SettingRow>
      </StackPanel>

      <Button Style="{StaticResource Skin.OutlineButton}" HorizontalAlignment="Left" Content="{s:Text Settings_Reset}"
              Command="{Binding ResetCommand}" CommandParameter="{x:Static model:SettingsSection.General}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
