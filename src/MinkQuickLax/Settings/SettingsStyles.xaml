<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:styles="clr-namespace:MinkQuickLax.Styles"
                    xmlns:settings="clr-namespace:MinkQuickLax.Settings"
                    xmlns:model="clr-namespace:MinkQuickLax.Core.Model;assembly=MinkQuickLax.Core">
  <!-- The settings window (SPEC 4.8, 5.10). Merged into the application resources so pages built in code can use
       StaticResource; every color, font and corner still comes from the style resources through DynamicResource. -->

  <Style x:Key="Settings.PageTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Skin.Ink}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Heading}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Settings.Hint" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Skin.Ink2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Settings.Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Skin.Ink2}" />
    <Setter Property="Margin" Value="0,12,0,4" />
  </Style>

  <!-- Space between groups of settings. -->
  <Style x:Key="Settings.Group" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,0,22" />
  </Style>

  <Style TargetType="settings:SettingsGroupHeader">
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="settings:SettingsGroupHeader">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource Danger}" Visibility="Collapsed" />
            <styles:LabelText x:Name="Title" Source="{TemplateBinding Text}" FontFamily="{DynamicResource Font.Label}" FontSize="12" FontWeight="SemiBold"
                              Foreground="{DynamicResource Skin.Ink2}" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="styles:Skin.Kind" Value="{x:Static model:StyleSetting.Hud}">
              <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Accent}" />
              <Setter TargetName="Title" Property="FontSize" Value="10.5" />
              <Setter TargetName="Title" Property="FontWeight" Value="Medium" />
            </Trigger>
            <Trigger Property="styles:Skin.Kind" Value="{x:Static model:StyleSetting.Dot}">
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
              <Setter TargetName="Title" Property="FontSize" Value="10.5" />
              <Setter TargetName="Title" Property="FontWeight" Value="Medium" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="settings:SettingRow">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="settings:SettingRow">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock FontFamily="{DynamicResource Font.Ui}" Foreground="{DynamicResource Skin.Ink}" FontSize="13.5" TextWrapping="Wrap" Text="{TemplateBinding HeaderText}" />
              <TextBlock FontFamily="{DynamicResource Font.Ui}" FontSize="12.5" Foreground="{DynamicResource Skin.Ink2}" TextWrapping="Wrap" Margin="0,1,0,0" Text="{TemplateBinding Hint}"
                         Visibility="{Binding Hint, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static settings:VisibleWhenConverter.Instance}}" />
            </StackPanel>
            <TextBlock x:Name="Value" Grid.Column="1" VerticalAlignment="Bottom" FontFamily="{DynamicResource Font.Mono}" FontSize="11.5"
                       Foreground="{DynamicResource Skin.Ink2}" Text="{TemplateBinding ValueText}" Visibility="Collapsed" />
            <ContentPresenter x:Name="Control" Grid.Column="1" VerticalAlignment="Center" />
            <Border x:Name="Outline" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="-8,-5" BorderThickness="1.5" BorderBrush="{DynamicResource Accent}"
                    CornerRadius="{DynamicResource Skin.Radius.Row}" IsHitTestVisible="False" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Outline" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Layout" Value="Stacked">
              <Setter TargetName="Value" Property="Visibility" Value="Visible" />
              <Setter TargetName="Control" Property="Grid.Row" Value="1" />
              <Setter TargetName="Control" Property="Grid.Column" Value="0" />
              <Setter TargetName="Control" Property="Grid.ColumnSpan" Value="2" />
              <Setter TargetName="Control" Property="Margin" Value="0,6,0,0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- Glass color swatches (SPEC 5.1): 135° from the color at 95% to 55%. -->
  <LinearGradientBrush x:Key="Settings.Swatch.Lagoon" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F22FD9BE" Offset="0" />
    <GradientStop Color="#8C2FD9BE" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Settings.Swatch.Ember" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F2FF7250" Offset="0" />
    <GradientStop Color="#8CFF7250" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Settings.Swatch.Ink" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F20A161C" Offset="0" />
    <GradientStop Color="#8C0A161C" Offset="1" />
  </LinearGradientBrush>
</ResourceDictionary>
