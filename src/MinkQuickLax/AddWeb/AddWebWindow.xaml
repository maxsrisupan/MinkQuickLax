<styles:StyledWindow x:Class="MinkQuickLax.AddWeb.AddWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:MinkQuickLax.Services"
        xmlns:styles="clr-namespace:MinkQuickLax.Styles"
        Title="{s:Text AddWeb_Title}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <!-- A message line that takes no space while it is empty. -->
    <Style x:Key="Message" TargetType="TextBlock" BasedOn="{StaticResource Skin.Text}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="2,4,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <styles:SurfaceFrame Fill="{DynamicResource Skin.Fill.Scanner}">
    <StackPanel Margin="18,14,18,18">
      <!-- Header (also the drag area) -->
      <Grid Margin="0,0,0,2">
        <TextBlock Style="{StaticResource Skin.Text}" FontFamily="{DynamicResource Font.Heading}" FontSize="20" FontWeight="SemiBold" Text="{s:Text AddWeb_Title}" />
        <Button Style="{StaticResource Skin.IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding CloseCommand}" Content="✕"
                AutomationProperties.Name="{s:Text Common_Close}" />
      </Grid>

      <!-- The example sits beside the label: the box has focus from the start, and a hint inside it only shows unfocused. -->
      <Grid>
        <TextBlock Style="{StaticResource Settings.Label}" Text="{s:Text AddWeb_Address}" />
        <TextBlock Style="{StaticResource Settings.Label}" HorizontalAlignment="Right" Opacity="0.75" Text="{s:Text AddWeb_AddressHint}" />
      </Grid>
      <TextBox x:Name="AddressBox" Style="{StaticResource Skin.TextBox}"
               Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{s:Text AddWeb_Address}" />
      <TextBlock Style="{StaticResource Message}" Foreground="{DynamicResource Danger}" Text="{Binding Error}" />
      <TextBlock Style="{StaticResource Message}" Foreground="{DynamicResource Skin.Amber}" Text="{s:Text AddWeb_AlreadyAdded}"
                 Visibility="{Binding AlreadyAdded, Converter={StaticResource Visible}}" />

      <TextBlock Style="{StaticResource Settings.Label}" Text="{s:Text Link_Name}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
          <!-- An empty tile until the address gives a name, so the row does not jump when the icon arrives. -->
          <Border Background="{DynamicResource Skin.FieldFill}" BorderBrush="{DynamicResource Skin.Edge}" BorderThickness="1"
                  CornerRadius="{DynamicResource Skin.Radius.Field}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>
          <Image Style="{StaticResource Skin.ListIcon}" Source="{Binding Icon}" />
        </Grid>
        <TextBox Grid.Column="1" Style="{StaticResource Skin.TextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{s:Text Link_Name}" />
      </Grid>

      <!-- SPEC 4.1: which browser opens the address. -->
      <TextBlock Style="{StaticResource Settings.Label}" Text="{s:Text Link_Browser}" />
      <ComboBox Style="{StaticResource Skin.ComboBox}" ItemsSource="{Binding Browsers}" SelectedItem="{Binding Browser}"
                AutomationProperties.Name="{s:Text Link_Browser}">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="s:BrowserChoice">
            <StackPanel Orientation="Horizontal">
              <Image Width="18" Height="18" Margin="0,0,8,0" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Style="{StaticResource Skin.Text}" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button Style="{StaticResource Skin.OutlineButton}" Content="{s:Text Common_Cancel}" Command="{Binding CloseCommand}" />
        <!-- IsDefault: Enter in either box adds, as long as the address box is not empty. -->
        <Button Style="{StaticResource Skin.AccentButton}" Margin="8,0,0,0" Content="{s:Text Scanner_Add}" Command="{Binding AddCommand}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </styles:SurfaceFrame>
</styles:StyledWindow>
