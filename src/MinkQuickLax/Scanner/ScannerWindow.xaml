<styles:StyledWindow x:Class="MinkQuickLax.Scanner.ScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:MinkQuickLax.Services"
        xmlns:scan="clr-namespace:MinkQuickLax.Scanner"
        xmlns:styles="clr-namespace:MinkQuickLax.Styles"
        Title="{s:Text Scanner_Title}"
        Width="560" Height="680" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">

  <Window.Resources>
    <scan:FilterConverter x:Key="FilterIs" />
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Skin.ScrollBar}" />
  </Window.Resources>

  <styles:SurfaceFrame Fill="{DynamicResource Skin.Fill.Scanner}">
    <Grid Margin="18,14,18,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header (also the drag area) -->
      <Grid Grid.Row="0" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Style="{StaticResource Skin.Text}" FontFamily="{DynamicResource Font.Heading}" FontSize="20" FontWeight="SemiBold" Text="{s:Text Scanner_Title}" />
          <TextBlock Style="{StaticResource Skin.Text}" Foreground="{DynamicResource Skin.Ink2}" FontSize="12.5" Margin="0,2,0,0" Text="{Binding Status}" />
        </StackPanel>
        <Button Style="{StaticResource Skin.IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding CloseCommand}" Content="✕"
                AutomationProperties.Name="{s:Text Common_Close}" />
      </Grid>

      <TextBlock Grid.Row="1" Style="{StaticResource Skin.Text}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"
                 Text="{s:Text Scanner_FirstRun}" Visibility="{Binding FirstRun, Converter={StaticResource Visible}}" />

      <!-- Search and filter -->
      <Grid Grid.Row="2" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" Style="{StaticResource Skin.TextBox}" Tag="{s:Text Scanner_Search}"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{s:Text Scanner_Search}" />
        <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="9" Padding="2" Background="{DynamicResource Skin.FieldFill}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Skin.Segment}" Content="{s:Text Scanner_FilterAll}" GroupName="filter"
                         IsChecked="{Binding Filter, Converter={StaticResource FilterIs}, ConverterParameter=All}" />
            <RadioButton Style="{StaticResource Skin.Segment}" Content="{s:Text Scanner_FilterPrograms}" GroupName="filter"
                         IsChecked="{Binding Filter, Converter={StaticResource FilterIs}, ConverterParameter=Programs}" />
            <RadioButton Style="{StaticResource Skin.Segment}" Content="{s:Text Scanner_FilterStore}" GroupName="filter"
                         IsChecked="{Binding Filter, Converter={StaticResource FilterIs}, ConverterParameter=Store}" />
            <RadioButton Style="{StaticResource Skin.Segment}" Content="{s:Text Scanner_FilterDesktop}" GroupName="filter"
                         IsChecked="{Binding Filter, Converter={StaticResource FilterIs}, ConverterParameter=Desktop}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Add by hand: file, folder, web address -->
      <Grid Grid.Row="3" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource Skin.Button}" MinWidth="0" Content="{s:Text Scanner_PickFile}" Click="OnPickFile" />
        <Button Grid.Column="1" Style="{StaticResource Skin.Button}" MinWidth="0" Margin="4,0,8,0" Content="{s:Text Scanner_PickFolder}" Click="OnPickFolder" />
        <StackPanel Grid.Column="2">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlBox" Style="{StaticResource Skin.TextBox}" Tag="{s:Text Scanner_UrlHint}"
                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnUrlKeyDown" AutomationProperties.Name="{s:Text Scanner_UrlHint}" />
            <!-- SPEC 4.1: which browser opens the web address. -->
            <ComboBox Grid.Column="1" Style="{StaticResource Skin.ComboBox}" Margin="6,0,0,0" MinWidth="130" MaxWidth="170"
                      ItemsSource="{Binding Browsers}" SelectedItem="{Binding Browser}" AutomationProperties.Name="{s:Text Link_Browser}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="s:BrowserChoice">
                  <StackPanel Orientation="Horizontal">
                    <Image Width="16" Height="16" Margin="0,0,6,0" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Style="{StaticResource Skin.Text}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <TextBlock Foreground="{DynamicResource Danger}" FontSize="12" Margin="2,2,0,0" Text="{Binding UrlError}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Skin.Text}">
                <Style.Triggers>
                  <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>

      <!-- Results -->
      <Grid Grid.Row="4">
        <ListBox x:Name="List" ItemsSource="{Binding View}" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource Skin.ListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" KeyboardNavigation.TabNavigation="Continue">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="scan:ScanItem">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource Skin.CheckBox}" VerticalAlignment="Center" IsChecked="{Binding IsChecked}"
                          IsEnabled="{Binding CanCheck}" AutomationProperties.Name="{Binding Name}" />
                <Image Grid.Column="1" Style="{StaticResource Skin.ListIcon}" Width="32" Height="32" Margin="10,0,6,0" Source="{Binding Icon}" />
                <TextBox Grid.Column="2" Style="{StaticResource Skin.InlineTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanCheck}" AutomationProperties.Name="{s:Text Scanner_Rename}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
                  <Border Style="{StaticResource Skin.Tag}" Margin="0,0,4,0" Visibility="{Binding AlreadyAdded, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Skin.Text}" FontSize="11" Foreground="{DynamicResource Accent}" Text="{s:Text Scanner_AlreadyAdded}" />
                  </Border>
                  <Border Style="{StaticResource Skin.Tag}">
                    <TextBlock Style="{StaticResource Skin.Text}" FontSize="11" Foreground="{DynamicResource Skin.Ink2}" Text="{Binding SourceLabel}" />
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ProgressBar Height="3" VerticalAlignment="Top" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" />
      </Grid>

      <!-- Footer -->
      <Grid Grid.Row="5" Margin="0,10,0,0">
        <TextBlock Style="{StaticResource Skin.Text}" Foreground="{DynamicResource Skin.Ink2}" VerticalAlignment="Center" Text="{Binding SelectionText}" />
        <Button Style="{StaticResource Skin.AccentButton}" HorizontalAlignment="Right" Content="{s:Text Scanner_Add}" Command="{Binding AddCommand}" />
      </Grid>
    </Grid>
  </styles:SurfaceFrame>
</styles:StyledWindow>
