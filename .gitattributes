# Normalize line endings in the repo; check out with the platform default.
* text=auto

# Windows-only scripts and solution files keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.slnx text eol=crlf

*.sh text eol=lf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.gif binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
