<Project>

  <!-- Central package management: every NuGet version is pinned here (PLAN.md section 1). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="App">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="SharpVectors.Wpf" Version="1.8.6" />
    <PackageVersion Include="Velopack" Version="1.2.0" />
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup Label="Core">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Platform">
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.333" />
  </ItemGroup>

  <ItemGroup Label="Tools">
    <PackageVersion Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
